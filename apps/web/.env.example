# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Require an invited Supabase session and workspace membership.
NEXT_PUBLIC_FULLKIT_AUTH=required

# Required only if the Supabase project has CAPTCHA protection enabled;
# without it every sign-in is rejected before the password is checked.
NEXT_PUBLIC_SUPABASE_CAPTCHA_SITEKEY=

# Do not add service-role keys to this file.
# Do not enable NEXT_PUBLIC_FULLKIT_REPO=supabase; that generic adapter is incomplete.
